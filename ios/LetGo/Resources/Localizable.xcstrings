        }
      }
    },
    "Nothing is saved or sent. It stays here a moment, then it's gone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is saved or sent. It stays here a moment, then it's gone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente viene salvato né inviato. Resta qui un momento, poi se ne va."
          }
        }
      }
    },
    "One slow breath.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One slow breath."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un respiro lento."
